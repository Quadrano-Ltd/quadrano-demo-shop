{"aggregate_id": "01M64PAZQB6Q2VRYWRQN3R6V59", "aggregate_type": "Mission", "event_id": "01M64PB1JB4JC4KNBTRQZM69YE", "event_type": "MissionCreated", "payload": {"actor": "57317291+digitalanalyticsdeveloper@users.noreply.github.com", "created_at": "2026-10-29T20:41:32.844807+00:00", "friendly_name": "Bring your own GTM container", "mission_id": "01M64PAZQB6Q2VRYWRQN3R6V59", "mission_number": null, "mission_slug": "byo-gtm-container-01M64PAZ", "mission_type": "software-dev", "purpose_context": "For the talk, attendees need to create, deploy and inspect a Quadrano Local snippet on the demo shop themselves, but they can't edit the shop's own GTM container. A visitor menu offers two paths: watch validation with the shop's pre-built container, or bring your own empty container and add the snippet. It also includes an event playground that pushes valid and broken events on demand. Source: GitHub issue Quadrano-Ltd/quadrano-demo-shop#4.", "purpose_tldr": "Let talk attendees and the presenter run Quadrano Local on the demo shop, using either the shop's pre-built GTM container or their own.", "target_branch": "feat/byo-gtm-container", "wp_count": 0}, "project_slug": "quadrano-demo-shop", "project_uuid": "caf26392-e52e-449d-95ee-b9612f5f703c", "schema_version": "5.0.0", "timestamp": "2026-10-29T20:41:34.539028+00:00"}
